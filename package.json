{
  "name": "naro-fashion",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "dev:storefront": "turbo dev --filter=storefront",
    "dev:admin": "turbo dev --filter=admin",
    "dev:api": "turbo dev --filter=api",
    "db:generate": "turbo db:generate --filter=@naro/database",
    "db:push": "turbo db:push --filter=@naro/database",
    "db:migrate": "turbo db:migrate --filter=@naro/database",
    "db:studio": "turbo db:studio --filter=@naro/database"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "liquidjs": ">=10.26.0",
      "africastalking>axios": "^1.15.1",
      "form-data@4": "^4.0.6",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "@nestjs/swagger>js-yaml": "^4.3.0",
      "@nestjs/serve-static>path-to-regexp": "^8.4.0",
      "@nestjs/swagger>path-to-regexp": "^8.4.0",
      "glob@10": "^10.5.0",
      "brace-expansion@2": "^2.1.2",
      "picomatch@2": "^2.3.2",
      "defu@6": "^6.1.5",
      "effect@3": "^3.20.0",
      "js-cookie@3": "^3.0.7",
      "linkify-it@5": "^5.0.1",
      "postcss@8": "^8.5.12"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
