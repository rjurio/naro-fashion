# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
out/
build/
# deploy.sh side-build / rollback dirs + deployed-SHA markers
.next-build/
.next-prev/
.next-failed/
dist-prev/
dist-prev.pending/
dist-failed/
.deploy/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# TypeScript incremental build state (machine-local, churns every build)
*.tsbuildinfo

# Local source material for bulk imports — NOT ship artifacts.
# (docs/screenshots/ is intentionally tracked: referenced by docs/USER_GUIDE.md)
docs/photo-staging/
docs/instagram/

# Private uploads (national ID documents etc.) — PII, never commit.
# Backed up off-site encrypted by scripts/ops/offsite-backup.sh.
apps/api/private-uploads/

# Prisma — migrations ARE committed (deploy.sh runs `prisma migrate deploy`).
# See docs/OPS/MIGRATIONS.md. Do not re-ignore packages/database/prisma/migrations/.

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Root-level scratch / API-response dumps (may contain live JWTs + admin PII).
# Ignore ALL root-level .json except the three real config files, so ad-hoc
# dumps like qa_login.json / admins.json can never be committed by accident.
# A new legitimate root config must be explicitly un-ignored below.
/*.json
!/package.json
!/tsconfig.base.json
!/turbo.json
